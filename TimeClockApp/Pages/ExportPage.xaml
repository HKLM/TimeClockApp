<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TimeClockApp.Pages.ExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TimeClockApp.ViewModels"
    Title="BackUp and Export"
    x:DataType="vm:ExportPageViewModel">
	<ContentPage.ToolbarItems>
		<ToolbarItem Command="{Binding ShowLogCommand}" IconImageSource="browse_activity.png" />
		<ToolbarItem Command="{Binding ToggleHelpInfoBoxCommand}" IconImageSource="help_icon.png" />
	</ContentPage.ToolbarItems>
	<Grid>
		<StackLayout Spacing="10">
			<Border
                x:Name="helpbox"
                Padding="8"
                IsVisible="{Binding HelpInfoBoxVisible}"
                VerticalOptions="Center">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="10"/>
				</Border.StrokeShape>
				<Label
                    Style="{StaticResource LabelSmall}" 
                    Text="Import/Export Database. &#10;&#10;. Export Data and Import Data is done by a ZIP file containing the CSV files of the data. &#10;&#10;Backup Database will create a copy of the existing Sqlite database (.db3) file and then give you a chose of where to put it. Note: There is no way to re-import this (.db3) file back into this app. Only the import of CSV data from a ZIP file is possible." />
			</Border>

			<Button Margin="15" Command="{Binding ExportDataCommand}" IsEnabled="{Binding ButtonDisabled}" Text="Export Data" />
			<Button Margin="15" Command="{Binding ToggleWarningBoxCommand}" IsEnabled="{Binding ButtonDisabled}" Text="Import Data" />
			<Button Margin="15" Command="{Binding BackupDBRequestCommand}" IsEnabled="{Binding ButtonDisabled}" Text="Backup Database" />
			<Label Text="Output Log:" IsVisible="{Binding LogTextVisible}" />
			<Label IsVisible="{Binding LogTextVisible}" 
                   MaxLines="200" 
                   Text="{Binding ExportLog}" 
				   FontSize="12" />
		</StackLayout>
		<Grid x:Name="LoadingOverlay1"
              Background="#80000000" 
              IsVisible="{Binding Loading}">

			<VerticalStackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center" 
                                 Spacing="15">
				<ProgressBar x:Name="WorkingProgressBar" Margin="5,5,5,10">
					<ProgressBar.Behaviors>
						<mct:ProgressBarAnimationBehavior 
                            x:Name="ProgressBarAnimationBehavior"
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference WorkingProgressBar}, x:DataType=ProgressBar}"
                            Progress="{Binding Progress}"
                            Length="150"/>
					</ProgressBar.Behaviors>
				</ProgressBar>
				<Label IsVisible="{Binding LogTextVisible}" 
                    MaxLines="200" 
					Text="{Binding ExportLog}" 
					FontSize="12" />
			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>
