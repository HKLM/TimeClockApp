<ContentPage x:Class="TimeClockApp.Pages.SettingsBasicPage"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	        xmlns:controls="clr-namespace:TimeClockApp.Controls"
            xmlns:Converter="clr-namespace:TimeClockApp.Converters"
	        xmlns:m="clr-namespace:TimeClockApp.Shared.Models;assembly=TimeClockApp.Shared"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	        xmlns:vm="clr-namespace:TimeClockApp.ViewModels"
	        x:Name="AppBasicSettingsPage"
            x:DataType="vm:SettingsBasicPageViewModel"
            Title="Settings">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding SaveSettingsCommand}" IconImageSource="save_dark.png" />
        <ToolbarItem Command="{Binding ToggleHelpInfoBoxCommand}" IconImageSource="help_icon.png" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Converter:DateOnlyToDateTimeConverter x:Key="dateOnlyToDateTimeConverter" />
            <Converter:AppThemeEnumToIntConverter x:Key="enumToIntConverter" />
            <Converter:WeekDayEnumToIntConverter x:Key="weekDayEnumToIntConverter" />
            <toolkit:IntToBoolConverter x:Key="intToBoolConverter" />
        </ResourceDictionary>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>
            <ActivityIndicator IsRunning="True" IsVisible="{Binding Loading}" />
            <VerticalStackLayout IsVisible="{Binding HasError}">
                <Label Text="Loading failed" />
                <Button Command="{Binding AppearingCommand}" Text="Retry" />
            </VerticalStackLayout>
            <Border
				x:Name="helpbox"
				Padding="8"
				IsVisible="{Binding HelpInfoBoxVisible}"
				VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Label
					LineBreakMode="WordWrap"
					Style="{StaticResource LabelSmall}"
					Text="Settings Page. &#10;&#10;System configuration settings. &#10;&#10;Note: Do NOT make changes unless you are sure of their impact." />
            </Border>

            <Grid ColumnDefinitions="200,*" RowDefinitions="70,65,65,70,65,65,65,65,65,70,65,65,65,70,65,65,65,65">
                <Label
                    Grid.ColumnSpan="2"
                    Style="{StaticResource LabelTitleName}"
					Text="Pay Days"
					HorizontalTextAlignment="Center" />
                <!--DaysInPayPeriod-->
                <Label
                    Grid.Row="1"
					Style="{StaticResource LabelSmallCenter}"
					Text="Days In Pay Period"
					VerticalTextAlignment="Center" />
                <Entry
                    x:Name="Config_DaysInPayPeriodBox"
                    Grid.Row="1"
					Grid.Column="1"
					Keyboard="Numeric"
					Text="{Binding Config_DaysInPayPeriod, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_DaysInPayPeriodBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="0"
							MinimumValue="1"
                            MaximumValue="31" />
                    </Entry.Behaviors>
                </Entry>
                <!--PayDayOfWeek-->
                <Label 
                    Grid.Row="2"
					Style="{StaticResource LabelSmallCenter}"
					Text="PayDay Is On"
					VerticalTextAlignment="Center" />
                <Picker
                    Grid.Row="2"
					Grid.Column="1"
                    VerticalOptions="Center" 
					ItemsSource="{Binding AllWeekDayNames}"
					SelectedIndex="{Binding Config_PayDayOfWeek, Converter={StaticResource weekDayEnumToIntConverter}}" 
                    Title="Pay Day" />
                <!--OVERHEAD & PROFIT RATES-->
                <Label 
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource LabelTitleName}"
                    Text="Overhead &amp; Profit Rates"
                    HorizontalTextAlignment="Center" />
                <!--WorkCompRate-->
                <Label 
                    Grid.Row="4"
					Style="{StaticResource LabelSmallCenter}"
					Text="Workers Compensation Rate"
					VerticalTextAlignment="Center" />
                <Entry
                    x:Name="Config_WorkCompRateBox"
                    Grid.Row="4"
					Grid.Column="1"
					Keyboard="Numeric"
					Text="{Binding Config_WorkCompRate, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_WorkCompRateBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="6"
							MinimumValue="0.0" />
                    </Entry.Behaviors>
                </Entry>
                <!--EstimateEmployerTaxes-->
                <Label 
                    Grid.Row="5"
					Style="{StaticResource LabelSmallCenter}"
					Text="Estimated Employer Taxes"
					VerticalTextAlignment="Center" />
                <Entry
                    x:Name="Config_EstimateEmployerTaxesBox"
                    Grid.Row="5"
					Grid.Column="1"
					Keyboard="Numeric"
					Text="{Binding Config_EstimateEmployerTaxes, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_EstimateEmployerTaxesBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="4"
							MinimumValue="0.0" />
                    </Entry.Behaviors>
                </Entry>
                <!--ProfitRate-->
                <Label 
                    Grid.Row="6"
					Style="{StaticResource LabelSmallCenter}"
					Text="Profit Rate"
					VerticalTextAlignment="Center" />
                <Entry
                    x:Name="Config_ProfitRateBox"
                    Grid.Row="6"
					Grid.Column="1"
					Keyboard="Numeric"
					Text="{Binding Config_ProfitRate, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_ProfitRateBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="2"
							MinimumValue="0.0" />
                    </Entry.Behaviors>
                </Entry>
                <!--OverHeadRate-->
                <Label 
                    Grid.Row="7"
					Style="{StaticResource LabelSmallCenter}"
					Text="OverHead Rate"
					VerticalTextAlignment="Center" />
                <Entry
                    x:Name="Config_OverHeadRateBox"
                    Grid.Row="7"
					Grid.Column="1"
					Keyboard="Numeric"
					Text="{Binding Config_OverHeadRate, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_OverHeadRateBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="2"
							MinimumValue="0.0" />
                    </Entry.Behaviors>
                </Entry>
                <!--AppTheme-->
                <Label 
                    Grid.Row="8"
					Style="{StaticResource LabelSmallCenter}"
					Text="App Theme"
					VerticalTextAlignment="Center" />
                <Picker
                    Grid.Row="8"
					Grid.Column="1"
                    VerticalOptions="Center" 
					ItemsSource="{Binding AllAppThemes}"
					SelectedIndex="{Binding Config_AppTheme, Converter={StaticResource enumToIntConverter}}" 
                    Title="App Theme" />
                <!--NOTIFICATIONS TITLE-->
                <Label 
                    Grid.Row="9"
                    Grid.ColumnSpan="2"
                    HorizontalTextAlignment="Center" 
                    Style="{StaticResource LabelTitleName}"
                    Text="Notifications" />
                <!--UseNotifications-->
                <Label 
                    Grid.Row="10"
					Style="{StaticResource LabelSmallCenter}"
					Text="Use Notifications"
					VerticalTextAlignment="Center" />
                <Switch 
                    x:Name="useNotificationsSwitch"
                    Grid.Row="10"
					Grid.Column="2"
                    IsToggled="{Binding Config_UseNotifications}" />
                <!--NotificationHours-->
                <Label
                    Grid.Row="11"
					Style="{StaticResource LabelSmallCenter}"
					Text="Hour:"
					VerticalTextAlignment="Center" />
                <Picker 
                    Grid.Row="11" 
                    Grid.Column="1" 
                    Title="Hours"
                    IsEnabled="{Binding Config_UseNotifications}"
                    ItemsSource="{Binding PickerHours,x:DataType=vm:SettingsBasicPageViewModel}"
                    SelectedItem="{Binding SelectedHours, x:DataType=vm:SettingsBasicPageViewModel}" />
                <Label
					Grid.Row="12"
					Style="{StaticResource LabelSmallCenter}"
					Text="Minute:"
					VerticalTextAlignment="Center" />
                <Picker 
                    Grid.Row="12" 
                    Grid.Column="1" 
                    Title="Minutes"
                    IsEnabled="{Binding Config_UseNotifications}"
                    ItemsSource="{Binding PickerMinutes,x:DataType=vm:SettingsBasicPageViewModel}"
                    SelectedItem="{Binding SelectedMinutes, x:DataType=vm:SettingsBasicPageViewModel}" />
                <!--<Entry
                    x:Name="Config_NotificationHoursBox"
                    Grid.Row="10"
					Grid.Column="1"
					Keyboard="Numeric"
                    IsEnabled="{Binding Config_UseNotifications}"
					Text="{Binding Config_NotificationHours, Mode=TwoWay}">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference Config_NotificationHoursBox}, x:DataType=Entry}"
							Flags="ValidateOnUnfocused"
							InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
							MaximumDecimalPlaces="1"
							MinimumValue="0.0" 
                            MaximumValue="24" />
                    </Entry.Behaviors>
                </Entry>-->
                <Label 
                    Grid.Row="13"
                    Grid.ColumnSpan="2"
                    HorizontalTextAlignment="Center" 
                    Style="{StaticResource LabelTitleName}"
                    Text="Internal App Settings" />
                <!--CurrentProject-->
                <Label 
                    Grid.Row="14"
					Style="{StaticResource LabelSmallCenter}"
					Text="Current Project"
					VerticalTextAlignment="Center" />
                <Picker
                    x:DataType="m:Project"
                    Grid.Row="14"
					Grid.Column="1"
                    VerticalOptions="Center" 
					ItemDisplayBinding="{Binding Name, x:DataType=m:Project}"
					ItemsSource="{Binding ProjectList, x:DataType=vm:SettingsBasicPageViewModel}"
					SelectedItem="{Binding CurrentProject, x:DataType=vm:SettingsBasicPageViewModel}"
                    Title="Project" />
                <!--CurrentPhase-->
                <Label 
                    Grid.Row="15"
					Style="{StaticResource LabelSmallCenter}"
					Text="Current Phase"
					VerticalTextAlignment="Center" />
                <Picker
                    x:DataType="m:Phase"
                    Grid.Row="15"
					Grid.Column="1"
                    VerticalOptions="Center" 
					ItemDisplayBinding="{Binding PhaseTitle, x:DataType=m:Phase}"
					ItemsSource="{Binding PhaseList, x:DataType=vm:SettingsBasicPageViewModel}"
					SelectedItem="{Binding CurrentPhase, x:DataType=vm:SettingsBasicPageViewModel}"
                    Title="Phase" />
                <!--IsAdmin-->
                <Label 
                    Grid.Row="16"
					Style="{StaticResource LabelSmallCenter}"
					Text="Is Admin"
					VerticalTextAlignment="Center" />
                <Switch
                    Grid.Row="16"
					Grid.Column="1"
                    IsToggled="{Binding Config_IsAdmin, Converter={StaticResource intToBoolConverter}}" />
                <!--FirstRun-->
                <Label 
                    Grid.Row="17"
					Style="{StaticResource LabelSmallCenter}"
					Text="First Run"
					VerticalTextAlignment="Center" />
                <DatePicker
                    Grid.Row="17"
					Grid.Column="1"
                    VerticalOptions="Center" 
                    IsEnabled="{Binding IsAdmin}"
					Date="{Binding Config_FirstRun, Converter={StaticResource dateOnlyToDateTimeConverter}}"
					MaximumDate="{Binding PickerMaxDate}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>