<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TimeClockApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<!--<Nullable>enable</Nullable>-->

		<!-- Display name -->
		<ApplicationTitle>Time Cards</ApplicationTitle>
		 <!--App Identifier--> 
		<ApplicationId>com.alexanderbuilder.timeclockapp</ApplicationId>
		 <!--Versions--> 
		<ApplicationIdGuid>AA699F0D-F30D-4094-AAEC-745B07309A2B</ApplicationIdGuid>
		<ApplicationVersion>12</ApplicationVersion>
		<ApplicationDisplayVersion>3.2</ApplicationDisplayVersion>
		<FileVersion>3.2</FileVersion>
		<AssemblyVersion>3.2</AssemblyVersion>
		<Version>3.2</Version>
		<!-- Enable Material 3 design on Android -->
		<UseMaterial3>true</UseMaterial3>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<Configurations>Debug;Release;MSSQL Migration;SQLite Migration</Configurations>
		<Copyright>2026 (c) Brian Alexander</Copyright>
		<Authors>Brian Alexander</Authors>
		<Company>Alexander Builder</Company>
		<Description>Employer TimeCard app to track amount of time employees has worked and for reporting weekly hours for payroll.</Description>
		<SourceRevisionId>build$([System.DateTime]::Now.ToString("yy.M.d:HH.mm"))</SourceRevisionId>
		<Title>TimeCards App</Title>
		<DefaultLanguage>en-us</DefaultLanguage>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<EnableSplashScreenProcessing>false</EnableSplashScreenProcessing>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<Features>runtime-async=on</Features>
		<WindowsPackageType>MSIX</WindowsPackageType>	  
		<DefineConstants>$(DefineConstants);SQLITE</DefineConstants>
		<!-- Replace xxxxxxxxxxxxxxx with your own PackageCertificateThumbprint value -->
		<!--<PackageCertificateThumbprint>xxxxxxxxxxxxxxx</PackageCertificateThumbprint>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>-->
		<!--<TargetPlatformAndroid>True</TargetPlatformAndroid>-->
		<!--<UseMonoRuntime>false</UseMonoRuntime>-->
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-android|AnyCPU'">
	  <!--<PublishReadyToRun>true</PublishReadyToRun>-->
	  <!--<MauiEnableFullReadyToRun>true</MauiEnableFullReadyToRun>-->
	  <!--<AndroidUseAapt2>true</AndroidUseAapt2>-->
	  <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <AndroidProfileStartup>true</AndroidProfileStartup>
	  <!--<PublishTrimmed>false</PublishTrimmed>-->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-windows10.0.19041.0|AnyCPU'">
		<!--<AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>xxxxxxxxxxxxxxx</PackageCertificateThumbprint>-->
	  <PublishReadyToRun>true</PublishReadyToRun>
	  <PublishTrimmed>false</PublishTrimmed>
	  <!--<PublishAot>false</PublishAot>-->
	</PropertyGroup>
  
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
	</PropertyGroup>
  
	<ItemGroup>
	  <MauiImage Include="Resources\Images\*.svg" ResizeQuality="Best" />
	  <MauiImage Include="Resources\Images\*.png" ResizeQuality="Best" />
	  <MauiImage Include="Resources\Images\ui\check_box_white.svg">
		<TintColor>#EFEFEF</TintColor>
	  </MauiImage>
	  <MauiFont Include="Resources\Fonts\*" />
	  <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
	  <!--<MauiIcon Include="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="White" />-->
	  <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ResizeQuality="Best" BaseSize="24,24" ForegroundScale="0.6" Color="White" TintColor="#0F4690" />
	</ItemGroup>
  
	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
	  <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ResizeQuality="Best" BaseSize="256,256">
		<TintColor>Black</TintColor>
	  </MauiIcon>		
	  <MauiSplashScreen Include="Platforms\Windows\Images\base\splashscreen.png" Color="#512BD4" BaseSize="288,288" />
	  <Content Include="Platforms\Windows\Images\winui\*.{png,svg}" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
	  <None Remove="Platforms\Windows\Images\winui\splashscreen.scale-100.png" />
	  <None Remove="Platforms\Windows\Images\winui\splashscreen.scale-125.png" />
	  <None Remove="Platforms\Windows\Images\winui\splashscreen.scale-150.png" />
	  <None Remove="Platforms\Windows\Images\winui\splashscreen.scale-200.png" />
	  <None Remove="Platforms\Windows\Images\winui\splashscreen.scale-400.png" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
	  <Content Include="Platforms\Windows\Images\winui\splashscreen.scale-100.png" />
	  <Content Include="Platforms\Windows\Images\winui\splashscreen.scale-125.png" />
	  <Content Include="Platforms\Windows\Images\winui\splashscreen.scale-150.png" />
	  <Content Include="Platforms\Windows\Images\winui\splashscreen.scale-200.png" />
	  <Content Include="Platforms\Windows\Images\winui\splashscreen.scale-400.png" />
	</ItemGroup>
		
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\TimeClockApp.Shared\TimeClockApp.Shared.csproj" />
	  <!--<TrimmerRootAssembly Include="TimeClockApp" RootMode="All" />-->
	  <TrimmerRootAssembly Include="TimeClockApp.Shared" RootMode="library" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Pages\ChangeStartTime.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\EditExpensePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\EditExpenseTypePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\EditExpenseTypeTab.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
